def pengembalian():
    os.system('cls')
    denda_per_hari = 50000
    print("---------------------------------------")
    print("          PENGEMBALIAN PRODUK          ")
    print("---------------------------------------")
    

    if not os.path.exists("transaksi.csv"):
        print("Belum ada transaksi.")
        input("\nTekan Enter untuk kembali..")
        return

    nomor = 0
    with open("transaksi.csv", "r") as file:
        reader = csv.reader(file)
        next(reader)
        for baris in reader:
            if len(baris) > 0 and baris[0] == usernamelogin and baris[8] == "Sedang Disewa":
                nomor += 1
                print("\n[" + str(nomor) + "]")
                print("Tanggal Sewa  :", baris[1])
                print("Harus Kembali :", baris[2])
                print("Barang        :", baris[4])

    if nomor == 0:
        print("Tidak ada barang yang sedang kamu sewa.")
        input("\nTekan Enter untuk kembali..")
        return

    pilih = input("\nPilih nomor sewa yang dikembalikan (0 = batal): ").strip()

    if pilih == "0":
        return
    if pilih.isdigit() == False or int(pilih) < 1 or int(pilih) > nomor:
        print("Pilihan tidak valid.")
        input("\nTekan Enter untuk kembali..")
        return

    barang = ""
    tanggal_balik = ""
    urutan = 0
    with open("transaksi.csv", "r") as file:
        reader = csv.reader(file)
        next(reader)
        for baris in reader:
            if len(baris) > 0 and baris[0] == usernamelogin and baris[8] == "Sedang Disewa":
                urutan += 1
                if urutan == int(pilih):
                    barang = baris[4]
                    tanggal_kembali = baris[2]

    print("\n--- PENGECEKAN BARANG ---")
    print("Masukkan jumlah yang kamu kembalikan untuk tiap barang.\n")

    cocok = True
    item = ""
    for huruf in barang + ";":
        if huruf == ";":
            item = item.strip()
            if item != "": 
                posisi = item.rfind(" x")
                nama = item[:posisi]
                jumlah_sewa = int(item[posisi + 2:])

                kembali = input(nama + " (disewa " + str(jumlah_sewa) + "): ").strip()
                if kembali.isdigit() == False or int(kembali) != jumlah_sewa:
                    cocok = False
                    print(" -> TIDAK COCOK")

            item = ""
        else:
            item += huruf
    if cocok == False:
        print("\nBarang yang dikembalikan tidak sesuai.")
        print("Pengembalian belum diproses")
        print("Silahkan kembalikan produk sesuai dengan yg Anda pinjam.")
        input("\nTekan Enter untuk kembali..")
        return

    batas = datetime.strptime(tanggal_kembali, "%d-%m-%Y")
    hari_ini = datetime.now()
    terlambat = (hari_ini - batas).days

    hari_terlambat = 0
    denda = 0
    if terlambat > 0:
        hari_terlambat = terlambat
        denda = hari_terlambat * denda_per_hari

    tanggal_dikembalikan = hari_ini.strftime("%d-%m-%Y")

    print("\n=== HASIL PENGEMBALIAN ===")
    print("Harus Kembali    :", tanggal_kembali)
    print("Dikembalikan     :", tanggal_dikembalikan)
    if hari_terlambat > 0:
        print("Terlambat    :", hari_terlambat, "hari")
        print("Denda        :", denda)
    else:
        print("Terimakasih sudah tepat waktu.")
    
    file_baru = not os.path.exists("data_pengembalian.csv")

    with open("data_pengembalian.csv", "a", newline="") as file:
        writer = csv.writer(file)

        if file_baru:
            writer.writerow(["Username", "Barang", "Tanggal Seharusnya Kembali", 
                             "Tanggal Dikembalikan", "Hari Terlambat", "Denda"])
        writer.writerow([usernamelogin, barang, tanggal_kembali, 
                         tanggal_dikembalikan, hari_terlambat, denda])
    urutan = 0
    with open("transaksi.csv", "r") as lama:
        with open("temp.csv", "w", newline="") as baru:
            reader = csv.reader(lama)
            writer = csv.writer(baru)

            writer.writerow(next(reader))

            for baris in reader:
                if len(baris) > 0:
                    if baris[0] == usernamelogin and baris[8] == "Sedang Disewa":
