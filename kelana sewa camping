def transaksi():
    os.system('cls')
    
    print("==============================")
    print("       TRANSAKSI KELANA       ")
    print("==============================")     

    jumlah_item = 0
    with open("keranjang.csv", "r") as file:
        reader = csv.reader(file)
        next(reader) 
        for baris in reader:
            if len(baris) > 0 and baris[0] == usernamelogin:
                jumlah_item += 1

    if jumlah_item == 0:
        print("Keranjang kosong. Silakan tambah barang dulu")
        input("Tekan Enter untuk kembali.")
        return
    
    print("\nSelamat Datang di KELANA,", usernamelogin)

    while True:
        try:
            tanggal_sewa = input("\nTanggal Mulai Sewa (DD-MM-YYYY): ")
            sewa = datetime.strptime(tanggal_sewa, "%d-%m-%Y")

            tanggal_kembali = input("Tanggal Kembali (DD-MM-YYYY): ")
            kembali = datetime.strptime(tanggal_kembali, "%d-%m-%Y")

            if kembali < sewa:
                print("Tanggal kembali tidak boleh sebelum tanggal sewa!")
            else:
                break

        except ValueError:
            print("Format tanggal salah!")

    durasi = (kembali - sewa).days
    if durasi == 0:
        durasi = 1

    print("Lama Sewa:", durasi, "Hari")

    os.system('cls')
    print("\n---------- RINCIAN TRANSAKSI ----------")
    print("Username:", usernamelogin)
    print("Tanggal Sewa:", tanggal_sewa)
    print("Tanggal Kembali:", tanggal_kembali)
    print("Durasi:", durasi, "Hari")

    total = 0
    daftar_barang = ""

    with open("keranjang.csv", "r") as file:
        reader = csv.reader(file)
        next(reader)
        for baris in reader:
            if len(baris) > 0 and baris[0] == usernamelogin:
                nama = baris[3]
                harga = int(baris[4])
                jumlah = int(baris[5])
                subtotal = harga * jumlah * durasi
                total += subtotal

                if daftar_barang != "":
                    daftar_barang += ";"
                daftar_barang += nama + " x" + str(jumlah)

                print("\nNama Barang:", nama)
                print("Harga/Hari: Rp", harga)
                print("Jumlah:", jumlah)
                print("Subtotal: Rp", subtotal)

    print("\nTotal Pembayaran: Rp", total)

    print("\n========== METODE PEMBAYARAN ==========")
    print("1. Cash")
    print("2. Transfer")

    metode = input("Pilih Pembayaran: ")
    status = "Belum Lunas"

    if metode == "1":
        metode = "Cash"
        uang = input("Uang Pembayaran: Rp ")

        if uang.isdigit() and int(uang) >= total:
            status = "Lunas"
            print("Kembalian: Rp", int(uang) - total)
        else:
            status = "Belum Lunas"
            print("Uang pembayaran tidak mencukupi!")

    elif metode == "2":
        metode = "Transfer"
        uang = input("Nominal Transfer: Rp")

        if uang.isdigit() and int(uang) == total:
            status = "Lunas"
            print("Transfer berhasil!")
        else:
            status = "Belum Lunas"
            print("Nominal transfer tidak sesuai!")

    else:
        print("Metode pembayaran tidak tersedia!")
        metode = "Tidak Valid"
        status = "Belum Lunas"

    
    if status == "Lunas":
        status_sewa = "Sedang Disewa"
    else:
        status_sewa = "Belum Dimulai"


    header = [
        "Username", "Tanggal Sewa", "Tanggal Kembali",
        "Durasi", "Barang", "Total", "Metode",
        "Status Pembayaran", "Status Sewa"
    ]

    file_baru = (
        not os.path.exists("transaksi.csv")
        or os.path.getsize("transaksi.csv") == 0
    )

    baru = pd.DataFrame([{
        "Username": usernamelogin,
        "Tanggal Sewa": tanggal_sewa,
        "Tanggal Kembali": tanggal_kembali,
        "Durasi": durasi,
        "Barang": daftar_barang,
        "Total": total,
        "Metode": metode,
        "Status Pembayaran": status,
        "Status Penyewaan": status_sewa
    }])


    if os.path.exists(file_transaksi) > 0:
        df = pd.read_csv(file_transaksi)
        df = pd.concat([df, baru,], ignore_index=True)
    else:
        df = baru

    df.to_csv(file_transaksi, index=False)
    
    
    if status == "Lunas":
        with open("keranjang.csv", "r") as file:
            reader = csv.reader(file)
            next(reader)
            for baris in reader:
                if len(baris) > 0 and baris[0] == usernamelogin:
                    if baris[1] == "satuan":
                        kurangi_stok_satuan(baris[2], int(baris[5]))
                    else:
                        kurangi_stok_bundling(baris[2], int(baris[5]))
        
        print("\nStok berhasil diperbarui!")
        kosongkan_keranjang()
        
        print("\n========== TRANSAKSI SELESAI ==========")
        print("Username:", usernamelogin)
        print("Metode Pembayaran:", metode)
        print("Total: Rp", total)
        print("Status Pembayaran:", status)
        print("Status Penyewaan:", status_sewa)
        print("Data berhasil disimpan!")

    else:
        print("\nTidak ada barang yang disewa.")



