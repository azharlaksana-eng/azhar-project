    stok = int(input("Stok awal:     "))

    baru = pd.DataFrame([{
        'no': no, 'nama_produk': nama,
        'harga_sewa_per_hari': harga, 'stok': stok
    }])
    df = pd.concat([df, baru], ignore_index=True)
    df.to_csv(file_barang, index=False)
