def riwayat():
    os.system('cls')
    print("---------------------------------------")
    print("           RIWAYAT TRANSAKSI           ")
    print("---------------------------------------")

    if not os.path.exists(file_transaksi):
        print("Belum ada transaksi.")
        input("\nTekan 'Enter' untuk kembali..")
        return

    df = pd.read_csv(
        file_transaksi,
        header=0,
        names=["Username", "Tanggal Sewa", "Tanggal Kembali", "Durasi", "Barang",
               "Total", "Metode", "Status Pembayaran", "Status Sewa"]    
    )

    if len(df) == 0:
        print("Belum ada riwayat transaksi.")
        input("\nTekan 'Enter' untuk kembali..")
        return

    tabel = df.drop(columns=["Barang"]).copy()
    tabel["Durasi"] = tabel["Durasi"].astype(str) + "Hari"
    tabel["Total"] = "Rp " + tabel["Total"].astype(str)
    tabel.insert(0, "No", range(1, len(tabel) + 1))
   

    print()
    print(tabulate(tabel, headers="keys", )

    
    lunas = df[df["Status Pembayaran"] == "Lunas"]
    print("\nTotal transaksi :", len(df))
    print("Total pemasukan : Rp", lunas["Total"].sum())

    input("\nTekan Enter untuk kembali..")
    os.system('cls')



def pengembalian_admin():
    os.system('cls')
    print("---------------------------------------")
    print("      PENGEMBALIAN   &   DENDA         ")
    print("---------------------------------------")
    

    if not os.path.exists(file_kembali) == 0:
        print("Belum ada barang yang dikembalikan.")
        input("\nTekan 'Enter' untuk kembali..")
        return

    df = pd.read_csv(
        file_kembali,
        header=0,
        names=["Username", "Barang", "Jadwal Kembali", "Dikembalikan",
               "Terlambat (hari)", "Denda"]
    )

    if len(df) == 0:
        print("Belum ada barang yang dikembalikan.")
        input("\nTekan Enter untuk kembali..")
        return

    tabel = df.copy()

    tabel["Barang"] = tabel["Barang"].astype(str).apply(
        lambda teks: teks if len(teks) <= 30 else teks[:30] + "..."
    )
    tabel["Denda"] = "Rp " + tabel["Denda"].astype(str)
    tabel.index = range(1, len(tabel) + 1)
    tabel.index.name = "No"

    print()
    print(tabel.to_string())

    print("\nTotal denda terkumpul: Rp", df["Denda"].sum())



