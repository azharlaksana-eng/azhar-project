def menu_satusatu():
    os.system('cls')
    print("--------------------------------------------------------")
    print("                     MENU SATU-SATU                     ")
    print("--------------------------------------------------------")
    df = pd.read_csv("data_barang.csv", dtype=str)

    for i in range(len(df)):
        harga = str(df.iloc[i, 2]).strip()
        stok = str(df.iloc[i, 3]).strip()

        if harga.isdigit():
            df.iloc[i, 2] = f"Rp {int(harga):,}".replace(",", ".")
        elif harga != "" and harga.lower() != "nan":
            df.iloc[i, 2] = harga
        else:
            df.iloc[i, 2] = "-"

        if stok == "" or stok.lower() == "nan":
            df.iloc[i, 3] = "-"
        else:
            df.iloc[i, 3] = stok

    print(
        tabulate(
            df[["no", "nama_produk", "harga_sewa_per_hari", "stok"]],
            headers=("No", "Nama Produk", "Sewa/Hari", "Stok"),
            tablefmt="simple",
            showindex=False,
        )
    )


