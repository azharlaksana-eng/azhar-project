                        if urutan == int(pilih):
                            baris[8] = "Sudah Dikembalikan"
                        writer.writerow(baris)

    os.replace("temp.csv", "transaksi.csv")

    print("\nPengembalian berhasil. Terimakasih!")
    input("\nTekan Enter untuk melanjutkan..")
